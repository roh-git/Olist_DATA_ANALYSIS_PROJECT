        },
        "id": "zLLXwsQHUa2j",
        "outputId": "cde61476-931c-407b-a409-01543f2b09c5"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ [전처리 2 완료] 진성 재구매 타겟 변수 생성 완료\n"
          ]
        }
      ],
      "source": [
        "# 1. 고객별 첫 구매일(min)과, 고유 구매일자 리스트(order_dates) 생성\n",
        "customer_orders = olist_df.groupby('customer_unique_id').agg(\n",
        "    first_order_date=('purchase_date', 'min'),\n",
        "    # 같은 날짜 중복 제거를 위해 set() 사용 후 정렬\n",
        "    order_dates=('purchase_date', lambda x: sorted(list(set(x))))\n",
        ").reset_index()\n",
        "\n",
        "# 2. 30일 이내 재구매 여부 판별 함수 정의\n",
        "def check_30d_repurchase(dates):\n",
        "    if len(dates) < 2:  # 구매일이 하루밖에 없는 사람 (단발성)\n",
        "        return 0\n",
        "    # 첫 구매일과 두 번째 구매일의 차이가 0초과 30일 이내면 1(재구매)\n",
        "    return 1 if 0 < (dates[1] - dates[0]).days <= 30 else 0\n",
        "\n",
        "# 3. 함수 적용하여 타겟 변수 생성\n",
        "customer_orders['target_30d'] = customer_orders['order_dates'].apply(check_30d_repurchase)\n",
        "\n",
        "print(\"✅ [전처리 2 완료] 진성 재구매 타겟 변수 생성 완료\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Q6iDaYcDRNYC"
      },
      "source": [
        "> [전처리 3] 관측창 통제: 분석 기간 종료 직전 가입자 제외 및 최종 데이터셋 완성"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 20,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bqpOSZuoUmRz",
        "outputId": "b1a7f009-3452-4c10-fc97-aacef326438e"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ [전처리 3 완료] 관측창 통제 및 타겟 결합 완료\n",
            "   - 관측창 확보된 유효 데이터 크기: (108941, 41)\n"
          ]
        }
      ],
      "source": [
        "# 1. 전체 데이터셋의 가장 마지막 주문일 확인\n",
        "max_dataset_date = olist_df['purchase_date'].max()\n",
        "\n",
        "# 2. 마지막 주문일 기준, 최소 30일 이전에 첫 구매를 한 '시간적 여유가 있는' 고객만 필터링\n",
        "# (이전에 에러가 났던 부분을 방지하기 위해 파이썬 내장 timedelta 사용)\n",
        "valid_customers = customer_orders[customer_orders['first_order_date'] <= (max_dataset_date - timedelta(days=30))]\n",
        "\n",
        "# 3. 만약 기존 olist_df에 target_30d가 잘못 붙어있다면 꼬임 방지를 위해 삭제\n",
        "if 'target_30d' in olist_df.columns:\n",
        "    olist_df = olist_df.drop(columns=['target_30d'])\n",
        "\n",
        "# 4. 필터링된 유효 고객(valid_customers)과 그들의 타겟 변수를 원본 olist_df에 이너 조인(Inner Join)\n",
        "olist_df = olist_df.merge(valid_customers[['customer_unique_id', 'target_30d']], on='customer_unique_id', how='inner')\n",
        "\n",
        "print(\"✅ [전처리 3 완료] 관측창 통제 및 타겟 결합 완료\")\n",
        "print(\"   - 관측창 확보된 유효 데이터 크기:\", olist_df.shape)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "jepgyc-8UngK"
      },
      "source": [
        "> [전처리 4] 가설 검증용 파생변수 생성 (배송 지연, 배송비 비율 등)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "PRlnDUozUq96",
        "outputId": "8c5ee69b-6c30-4cf7-97bf-9d4dd80cb0af"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ [전처리 4 완료] 가설 검증용 파생 변수 생성 완료\n"
          ]
        }
      ],
      "source": [
        "# 1. [통제변수] 배송 지연 여부 (실제 배송일 > 배송 예정일 이면 1, 아니면 0)\n",
        "olist_df['is_late'] = (olist_df['order_delivered_customer_date'] > olist_df['order_estimated_delivery_date']).astype(int)\n",
        "\n",
        "# 2. [가설 4] 배송비 부담률 = 배송비 / (상품가격 + 배송비)\n",
        "# 분모가 0이 되어 무한대(Inf)가 나오는 것을 방지하기 위해 아주 작은 수(1e-5)를 더해줌\n",
        "olist_df['freight_ratio'] = olist_df['freight_value'] / (olist_df['price'] + olist_df['freight_value'] + 1e-5)\n",
        "\n",
        "print(\"✅ [전처리 4 완료] 가설 검증용 파생 변수 생성 완료\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "wcziRFAmy8zH"
      },
      "source": [
        "> [전처리 5] 중복제거 (데이터 누수 차단 및 EDA 데이터셋 분리)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 22,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oZIWaCoG9Fcj",
        "outputId": "939e15e7-c066-4af3-b377-695c1e825cfe"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ [전처리 5 완료] 고객 단위(1인 1행) EDA용 요약 데이터(eda_df) 구축 완료\n",
            "   - 최종 EDA 데이터셋 크기: (87748, 8)\n"
          ]
        }
      ],
      "source": [
        "# 1. 고객별 가장 처음 발생한 '첫 주문번호(order_id)' 찾기\n",
        "first_orders = olist_df.sort_values('order_purchase_timestamp').groupby('customer_unique_id')['order_id'].first().reset_index()\n",
        "\n",
        "# 2. 첫 주문번호에 해당하는 데이터(미래의 두 번째 결제 내역 차단)만 추출\n",
        "first_purchase_df = olist_df[olist_df['order_id'].isin(first_orders['order_id'])]\n",
        "\n",
        "# 3. 중복 제거의 올바른 방법: 고객 1명당 1줄의 요약본(eda_df)으로 집계(Aggregation)\n",
        "# 이 과정에서 '가설 1. 카테고리 다양성' 검증을 위한 nunique()가 계산됩니다.\n",
        "eda_df = first_purchase_df.groupby('customer_unique_id').agg(\n",
        "    category_count=('product_category_name', 'nunique'),     # [가설 1] 장바구니 속 카테고리 종류 수\n",
        "    purchase_date=('order_purchase_timestamp', 'first'),     # [가설 2] 구매 일자\n",
        "    installments=('payment_installments', 'max'),            # [가설 3] 최대 할부 개월 수\n",
        "    freight_ratio=('freight_ratio', 'mean'),                 # [가설 4] 장바구니 평균 배송비 부담률\n",
        "    review_score=('review_score', 'first'),                  # [가설 5] 첫 리뷰 점수\n",
        "    is_late=('is_late', 'max'),                              # 배송 지연 경험 여부 (하나라도 지연됐으면 1)\n",
        "    target_30d=('target_30d', 'first')                       # 30일 이내 진성 재구매 여부\n",
        ").reset_index()\n",
        "\n",
        "print(\"✅ [전처리 5 완료] 고객 단위(1인 1행) EDA용 요약 데이터(eda_df) 구축 완료\")\n",
        "print(\"   - 최종 EDA 데이터셋 크기:\", eda_df.shape)"
      ]
    },
