    {
      "cell_type": "markdown",
      "metadata": {
        "id": "kjtnkKxkSXzh"
      },
      "source": [
        "> [전처리 1] 날짜 데이터(String)를 실제 시간 데이터(Datetime)로 변환"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 18,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "spWPD51UoFw4",
        "outputId": "a5866914-ebe4-4e08-e94c-41576f3bf721"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "✅ [전처리 1 완료] 날짜 데이터 변환 완료\n"
          ]
        }
      ],
      "source": [
        "import pandas as pd\n",
        "from datetime import timedelta\n",
        "\n",
        "# 분석에 사용할 주요 날짜 컬럼 목록\n",
        "DATE_COLS = [\n",
        "    'order_purchase_timestamp', 'order_approved_at',\n",
        "    'order_delivered_carrier_date', 'order_delivered_customer_date',\n",
        "    'order_estimated_delivery_date'\n",
        "]\n",
        "\n",
        "# 1. 텍스트를 날짜(datetime) 타입으로 일괄 변환 (에러 발생 시 강제로 결측치 처리)\n",
        "for c in DATE_COLS:\n",
        "    olist_df[c] = pd.to_datetime(olist_df[c], errors='coerce')\n",
        "\n",
        "# 2. 날짜 연산 및 중복 결제 병합을 위해 시간(시간:분:초)을 떼어낸 순수 날짜(Date) 컬럼 생성\n",
        "olist_df['purchase_date'] = olist_df['order_purchase_timestamp'].dt.date\n",
        "\n",
        "print(\"✅ [전처리 1 완료] 날짜 데이터 변환 완료\")"
      ]
    },
